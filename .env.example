# Environment Configuration Example for ACME Salary Management System

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/acme_salary
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Authentication & Security
SECRET_KEY=replace-with-a-very-strong-random-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Initial Admin Bootstrap (Used during seed / bootstrap command)
ADMIN_EMAIL=hr.manager@acme.corp
ADMIN_INITIAL_PASSWORD=AcmeHR2026!SecurePass

# Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Next.js Public Environment
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
